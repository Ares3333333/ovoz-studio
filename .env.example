# Ovoz Studio — пример конфигурации.
# Скопируй в `.env` (gitignored) и выстави права: `chmod 600 .env`.
# docker-compose подхватит .env автоматически; uvicorn в локальной разработке — через `set -a && . ./.env`.

# === обязательно для боя ===
# HMAC-ключ подписей платежей Payme/Click/Telegram Stars.
# Без него /api/payments/webhook/* отвечает 501 (закрыт).
OVOZ_WEBHOOK_SECRET=replace-with-long-random-string

# Ключ для /api/dev/demo-credit (витрина/тренеры). Без него 403 на все попытки.
OVOZ_ADMIN_SECRET=replace-with-another-long-random-string

# 1 = разрешить демо-начисление (для витрины/разработки). В бою держи 0 или не ставь.
OVOZ_ALLOW_DEMO_CREDIT=0

# === Telegram Mini App (когда выдашь бота у BotFather) ===
TELEGRAM_BOT_TOKEN=

# === провайдеры AI ===
# sim — офлайн-демо (словарь+заглушки), real — Whisper CLI, openai — GPT, edge — edge-tts
OVOZ_ASR_PROVIDER=sim
OVOZ_TRANSLATE_PROVIDER=sim
OVOZ_TTS_PROVIDER=sim

# пути к бинарям (по умолчанию в PATH)
# OVOZ_WHISPER_BIN=/usr/local/bin/whisper
# OVOZ_FFMPEG_BIN=ffmpeg
# OVOZ_FFPROBE_BIN=ffprobe

# ключ OpenAI — только если OVOZ_TRANSLATE_PROVIDER=openai
OPENAI_API_KEY=
OVOZ_OPENAI_MODEL=gpt-4o-mini

# === тюнинг ===
# стартовый бонус новых аккаунтов, минуты
OVOZ_SIGNUP_BONUS_MINUTES=10
# 1 = обрабатывать jobs синхронно в запросе (только для тестов/разработки)
OVOZ_SYNC_PIPELINE=0
# каталог данных (в контейнере уже /data)
OVOZ_DATA_DIR=./data
# дни хранения файлов завершённых jobs (0 = не чистить)
OVOZ_RETENTION_DAYS=7
# IP доверенных реверс-прокси (через запятую). XFF читается ТОЛЬКО с этих адресов.
# Пример: nginx на том же хосте → 127.0.0.1
# OVOZ_TRUSTED_PROXIES=127.0.0.1,10.0.0.1
